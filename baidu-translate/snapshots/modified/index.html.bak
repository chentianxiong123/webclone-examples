.hc-rp-copilot-bubble{align-items:baseline;display:flex;font-size:13px;line-height:1.7;color:rgba(11,13,41,.8)}
.hc-rp-copilot-bubble img{margin-right:6px;vertical-align:middle;flex-shrink:0}
.hc-rp-copilot-login{color:#999;font-size:12px;text-align:center;padding-top:10px}
.hc-rp-copilot-login span{color:#4d85ff;cursor:pointer;margin-left:4px}

/* 右侧条（原 .fYmMHp6G：flex column，tab 顶 fab 底，中间留白） */
.hc-right-side{align-items:center;display:flex;flex-direction:column;height:100%;justify-content:space-between;flex-shrink:0;padding-top:12px;padding-bottom:12px;box-sizing:border-box}

</style>
